{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict",
  "type": "object",
  "required": ["id", "date", "scorer", "method", "runs", "evidence", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^v-\\d{8}T\\d{6}Z$" },
    "date": { "type": "string", "format": "date-time" },
    "scorer": { "enum": ["agent", "human"] },
    "scored_by": { "type": "string" },
    "method": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^run-\\d{3,}$" }
    },
    "scenes": { "type": "array", "items": { "type": "string" } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "enum": ["unreviewed", "confirmed", "rejected", "superseded"] },
    "supersedes": { "type": "string", "pattern": "^v-\\d{8}T\\d{6}Z$" },
    "reviewed_by": { "type": "string" }
  }
}
