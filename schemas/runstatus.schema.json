{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runstatus",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "enum": [
        "created",
        "queued",
        "running",
        "succeeded",
        "failed",
        "aborted"
      ]
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "finished": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer"
    }
  }
}
